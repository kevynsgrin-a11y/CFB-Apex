# Surgical change to worker/index.ts
#
# NOT a full-file replacement. The deployed bundle does not expose this file's
# import block, so only the hunks below are specified — leave imports, and
# everything else in the file, untouched.
#
# Four edits: one new import, one function signature + body change, three call
# sites updated to pass `env`.
#
# Whitespace below is tabs, matching the emitted bundle.

--- a/worker/index.ts
+++ b/worker/index.ts
@@ imports @@
+import { isProductionLaunchReady } from "../lib/release-readiness";


@@ secureResponse @@
 /** Cloudflare Worker entry point for the vinext-starter template. */
-function secureResponse(response, url) {
+function secureResponse(response, url, env) {
 	const secured = new Response(response.body, response);
 	secured.headers.set("Content-Security-Policy", "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; media-src 'none'; worker-src 'self';");
 	secured.headers.set("Referrer-Policy", "strict-origin-when-cross-origin");
 	secured.headers.set("X-Content-Type-Options", "nosniff");
 	secured.headers.set("X-Frame-Options", "DENY");
 	secured.headers.set("Permissions-Policy", "camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=()");
 	secured.headers.set("Cross-Origin-Opener-Policy", "same-origin");
-	secured.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
+	// Suppress indexing until every production launch gate passes. The LIVE_MODE
+	// gate keeps this active while DEMO_MODE/DISABLE_LIVE_PROVIDERS are set, so
+	// fixture data can never be indexed.
+	if (!isProductionLaunchReady(env ?? {})) {
+		secured.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
+	}
 	if (url.protocol === "https:") secured.headers.set("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
 	return secured;
 }


