# ===========================================================================
# HUNK 1 — NF-1: stop trusting the ChatGPT identity header on public requests
#
# READ THE CAVEAT BELOW BEFORE APPLYING THIS HUNK.
#
# app/chatgpt-auth.ts derives user identity from `oai-authenticated-user-email`
# with no signature or session check. vinext's filterInternalHeaders() does not
# strip it, and no Cloudflare Access / WAF / Transform rule covers this zone, so
# the value is attacker-controlled on any direct request.
# ===========================================================================

@@ module scope — add near the top, after imports @@
+/**
+ * Identity headers injected by a trusted upstream (the ChatGPT app proxy).
+ * They carry no signature, so they must never be accepted from the open
+ * internet — see app/chatgpt-auth.ts / getChatGPTUser().
+ */
+const UPSTREAM_IDENTITY_HEADERS = [
+	"oai-authenticated-user-email",
+	"oai-authenticated-user-full-name",
+	"oai-authenticated-user-full-name-encoding",
+];
+
+/**
+ * Returns a Request with upstream identity headers removed unless the caller
+ * proved it is the trusted proxy by presenting the shared secret.
+ *
+ * Set TRUSTED_PROXY_SECRET as a Worker *secret* (not plain_text) and have the
+ * proxy send it as `x-trusted-proxy-secret`. With the secret unset, identity
+ * headers are ALWAYS stripped — fail-closed.
+ */
+function stripSpoofableIdentityHeaders(request, env) {
+	const expected = env?.TRUSTED_PROXY_SECRET;
+	const presented = request.headers.get("x-trusted-proxy-secret");
+	if (expected && presented && presented === expected) return request;
+
+	let hasAny = false;
+	for (const name of UPSTREAM_IDENTITY_HEADERS) {
+		if (request.headers.has(name)) { hasAny = true; break; }
+	}
+	if (!hasAny) return request;
+
+	const headers = new Headers(request.headers);
+	for (const name of UPSTREAM_IDENTITY_HEADERS) headers.delete(name);
+	headers.delete("x-trusted-proxy-secret");
+	return new Request(request, { headers });
+}


